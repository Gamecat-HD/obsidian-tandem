# Kopieren nach deploy/local.env und anpassen. local.env ist in .gitignore.
# Wird von deploy/redeploy.sh und deploy/admin-setup.sh gelesen.
PORTAINER_URL=https://portainer.example.com
PORTAINER_ENDPOINT=1
# API-Key aus Portainer (My account → Access tokens), Standard: ~/.config/portainer/token
# PORTAINER_TOKEN_FILE=~/.config/portainer/token
TANDEM_PUBLIC_URL=https://tandem.example.com
TANDEM_ADMIN_USER=admin
