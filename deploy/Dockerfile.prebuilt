# Image aus dem vorab gebauten statischen Binary (server/build-static.sh) – auf dem Server wird nichts kompiliert.
# Build-Kontext: tandem-server + leerer Ordner data/
FROM scratch
COPY tandem-server /tandem-server
COPY --chown=10001:10001 data /data
ENV TANDEM_DATA=/data TANDEM_LISTEN=0.0.0.0:8080 RUST_LOG=tandem_server=info
VOLUME /data
EXPOSE 8080
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s CMD ["/tandem-server", "healthcheck"]
ENTRYPOINT ["/tandem-server"]
CMD ["serve"]
